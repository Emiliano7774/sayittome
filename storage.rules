rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAllowedMedia() {
      return request.resource.size < 120 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    match /usuarios/{userId}/perfil/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isAllowedMedia();
    }

    match /usuarios/{userId}/fotos/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isAllowedMedia();
    }

    match /usuarios/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isAllowedMedia();
    }

    match /historias/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isAllowedMedia();
    }

    match /historias/anon/{sessionId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isAllowedMedia();
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.size < 120 * 1024 * 1024;
    }
  }
}
