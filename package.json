    "copy:apk": "node scripts/copy-apk.mjs",
    "build:apk": "node scripts/bump-apk-version.mjs && node scripts/sync-android-version.mjs && npm run generate:icons && npm run cap:sync && cd android && gradlew.bat assembleRelease && cd .. && node scripts/sign-apk.mjs && npm run copy:apk",
    "build:aab": "node scripts/bump-apk-version.mjs && node scripts/sync-android-version.mjs && npm run generate:icons && npm run cap:sync && cd android && gradlew.bat bundleRelease && cd .. && npm run copy:aab",
    "copy:aab": "node scripts/copy-aab.mjs",
    "publish:apk": "npm run build:apk",
    "deploy:hosting": "node scripts/firebase-deploy-hosting.mjs",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions:chat-push",
    "deploy:all": "npm run publish:apk && npm run deploy:hosting && firebase deploy --only storage,firestore:indexes --non-interactive --force",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
