    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nsfwjs": "^4.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-use": "^17.6.0",
    "storage": "^0.2.0",
    "wavesurfer.js": "^7.12.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-admin": "^14.1.0",
    "playwright": "^1.61.1",
