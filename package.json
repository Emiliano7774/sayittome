{
  "name": "sayittome-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prune-next-dev-artifacts.mjs",
    "build:trace": "node scripts/build-with-nav-trace.mjs",
    "bench:baseline": "node scripts/nav-bench-baseline.mjs --base http://localhost:3002 --warm 5",
