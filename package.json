    "test:shuffle-online-privacy-notice": "node scripts/shuffle-online-privacy-notice.harness.mjs",
    "test:chat-message-authorship": "node scripts/chat-message-authorship.harness.mjs",
    "test:chat-authorship-lifecycle": "node scripts/chat-authorship-lifecycle.harness.mjs",
    "audit:authorship-v2": "node scripts/audit-chat-authorship-v2-dry-run.mjs",
    "test:historical-authorship-repair": "node --experimental-strip-types scripts/historical-authorship-repair.harness.mjs",
    "test:historical-repair-safety": "node --experimental-strip-types scripts/historical-repair-safety.harness.mjs",
    "audit:historical-repair-inventory": "node --experimental-strip-types scripts/inventory-historical-authorship-queue.mjs",
    "verify:hosting": "node scripts/verify-hosting-release.mjs",
    "test:chat-thread-warm-first-frame": "node scripts/chat-thread-warm-first-frame.harness.mjs",
    "test:fcm-push-pipeline": "node scripts/fcm-push-pipeline.harness.mjs",
    "test:fcm-registration": "node --experimental-strip-types scripts/fcm-registration.harness.mjs",
    "test:android-fcm-wiring": "node scripts/android-fcm-wiring.harness.mjs",
    "test:chat-stories-warm-paint": "node --experimental-strip-types scripts/chat-stories-warm-paint.harness.mjs",
    "test:story-seen-persistence": "node --experimental-strip-types scripts/story-seen-persistence.harness.mjs",
    "test:story-deep-link-auth": "node --experimental-strip-types scripts/story-deep-link-auth.harness.mjs",
    "test:stories-index-121": "node --experimental-strip-types scripts/stories-index-121.harness.mjs",
    "test:stories-next-target": "node --experimental-strip-types scripts/stories-next-target.harness.mjs",
    "test:stories-snapshot-ttl": "node --experimental-strip-types scripts/stories-snapshot-ttl.harness.mjs",
    "test:session-notify-restore": "node scripts/session-notify-restore.harness.mjs"
