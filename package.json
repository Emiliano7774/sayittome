    "bench:setup": "node scripts/bench-setup-account.mjs --base http://localhost:3002",
    "capture:auth-login": "node scripts/auth-real-filmstrip.mjs --login --base https://sayittome-app.web.app",
    "capture:auth-validate": "node scripts/auth-real-filmstrip.mjs --validate --base https://sayittome-app.web.app",
    "capture:auth": "node scripts/auth-real-filmstrip.mjs --capture --base https://sayittome-app.web.app",
    "capture:auth-diag": "node scripts/auth-real-filmstrip.mjs --capture --diag --base https://sayittome-app.web.app",
    "bench:seed-stories": "node scripts/bench-seed-stories.mjs",
    "bench:verify-sytm": "node scripts/verify-sytm-domain.mjs --username navbench",
    "bench:chats-defer-after": "node scripts/nav-bench-baseline.mjs --base http://localhost:3002 --only tab→chats-B --defer-inbox 1 --warm 5 --out scripts/nav-bench-chats-defer-after.json",
