            <div className="flex h-16 flex-1 items-center rounded-full bg-[#090909] px-5">

              <input
                ref={inputRef}
                value={text}
                onChange={(e) => setText(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter") {
                    e.preventDefault();
                    sendMessage();
                  }
                }}
                placeholder="EscribÃ­ un mensaje..."
