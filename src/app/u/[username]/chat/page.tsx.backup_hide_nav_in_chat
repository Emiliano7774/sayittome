              {imagePreview ? (
                <img
                  src={imagePreview}
                  className="max-h-[320px] rounded-[26px]"
                />
              ) : null}

              {uploadProgress !== null ? (
                <div className="mt-4 h-3 overflow-hidden rounded-full bg-black/30">
                  <div
                    className="h-full bg-violet-500/80 backdrop-blur-xl/80 backdrop-blur-xl"
                    style={{
                      width: `${uploadProgress}%`,
                    }}
                  />
                </div>
              ) : null}

              <div className="mt-5 flex gap-4">

                <button
