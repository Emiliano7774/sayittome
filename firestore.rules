rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'emilianomaturano@gmail.com';
    }

    // Bomb media secrets: client SDK deny-all.
    // Admin SDK (Cloud Functions) bypasses security rules.
    match /viewOnceSecrets/{secretId} {
      allow read, write: if false;
    }

    match /usuarios/{uid} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && request.auth.uid == uid;
    }

    match /usuarios_shuffle_lite/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /chat_inbox_lite/{chatId} {
      allow read: if isLoggedIn();
      allow write: if false;
    }

    match /historias/{storyId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    match /photo_moderation_chats/{docId} {
      allow read, write: if isAdmin();
    }

    // Preserved productive catch-all. Exclude viewOnceSecrets via collection
    // segment (never Path→string conversion — that can fail-closed and
    // deny all chats/** writes that only match this block).
    match /{collection}/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31)
        && collection != 'viewOnceSecrets';
    }
  }
}
