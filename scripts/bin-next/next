#!/usr/bin/env node
/**
 * Firebase Hosting frameworks invokes `next build` directly. After build,
 * FAIL CLOSED if any firebase-admin-<hash> remains in .next/server.
 * Materializing aliases is NOT success — source must use opaque native require.
 */
const { spawnSync } = require("node:child_process");
const { existsSync, readdirSync, readFileSync } = require("node:fs");
const { join, resolve } = require("node:path");

const root = resolve(__dirname, "..", "..");
const realNext = join(root, "node_modules", "next", "dist", "bin", "next");
if (!existsSync(realNext)) {
  console.error("[next-ssr-bin] missing next binary at", realNext);
  process.exit(1);
}

const args = process.argv.slice(2);
const result = spawnSync(process.execPath, [realNext, ...args], {
  stdio: "inherit",
  cwd: process.cwd(),
  env: process.env,
});

const code = result.status == null ? 1 : result.status;
if (code === 0 && args[0] === "build") {
  // Next 16 can let a late worker flush middleware-manifest.json a few seconds
  // after the main build process exits. Firebase Frameworks reads it immediately,
  // which creates an ENOENT race. Wait briefly for the manifest before handing
  // control back to Firebase. This is deploy-only and does not affect runtime.
  const serverDir = join(process.cwd(), ".next", "server");
  const middlewareManifest = join(serverDir, "middleware-manifest.json");
  const manifestDeadline = Date.now() + 12_000;
  while (!existsSync(middlewareManifest) && Date.now() < manifestDeadline) {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100);
  }
  if (!existsSync(middlewareManifest)) {
    console.error(
      "[next-ssr-bin] FAIL: middleware-manifest.json was not materialized within 12s",
    );
    process.exit(1);
  }
  console.log("[next-ssr-bin] middleware-manifest ready");

  const { collectHashedRefsFromDir } = require("../materialize-next-hashed-externals.cjs");
  const refs = [...collectHashedRefsFromDir(serverDir)];
  const FIREBASE_ADMIN_HASHED = /firebase-admin-[a-f0-9]+/gi;
  const raw = new Set();
  function walk(dir) {
    if (!existsSync(dir)) return;
    for (const name of readdirSync(dir, { withFileTypes: true })) {
      const p = join(dir, name.name);
      if (name.isDirectory()) {
        walk(p);
        continue;
      }
      if (!name.name.endsWith(".js") && !name.name.endsWith(".json")) continue;
      let text;
      try {
        text = readFileSync(p, "utf8");
      } catch {
        continue;
      }
      for (const m of text.matchAll(FIREBASE_ADMIN_HASHED)) raw.add(m[0]);
    }
  }
  walk(serverDir);
  const all = [...new Set([...refs, ...raw])];
  if (all.length) {
    console.error(
      "[next-ssr-bin] FAIL: firebase-admin-<hash> still in .next/server:",
      all.join(", "),
    );
    console.error(
      "[next-ssr-bin] Use src/lib/admin/firebaseAdminNative.ts (opaque require). Materialize is NOT a fix.",
    );
    process.exit(1);
  }
  console.log("[next-ssr-bin] zero-hash gate PASS (no firebase-admin-<hash> in .next/server)");
}

process.exit(code);
