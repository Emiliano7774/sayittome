#!/usr/bin/env node
/**
 * Firebase Hosting frameworks invokes `next build` directly (ignores npm
 * scripts/postbuild). This shim replaces node_modules/.bin/next so every build
 * materializes Turbopack hashed externals (and asserts they resolve) before
 * Firebase packages the SSR Cloud Function for Linux GCF.
 */
const { spawnSync } = require("node:child_process");
const { existsSync } = require("node:fs");
const { join, resolve } = require("node:path");

const root = resolve(__dirname, "..", "..");
const realNext = join(root, "node_modules", "next", "dist", "bin", "next");
if (!existsSync(realNext)) {
  console.error("[next-ssr-bin] missing next binary at", realNext);
  process.exit(1);
}

const args = process.argv.slice(2);
const result = spawnSync(process.execPath, [realNext, ...args], {
  stdio: "inherit",
  cwd: process.cwd(),
  env: process.env,
});

const code = result.status == null ? 1 : result.status;
if (code === 0 && args[0] === "build") {
  const { materializeAndAssert } = require("../materialize-next-hashed-externals.cjs");
  const out = materializeAndAssert({
    cwd: process.cwd(),
    nextNodeModules: join(process.cwd(), ".next", "node_modules"),
  });
  console.log(
    `[next-ssr-bin] hashed externals scanned=${out.scanned} materialized=${out.fixed.length} ok=${out.asserted.resolved.length}`,
  );
}

process.exit(code);
